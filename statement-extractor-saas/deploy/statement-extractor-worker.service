[Unit]
Description=Statement Extractor Celery worker (OCR/extraction/ML jobs)
After=network.target redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/statement-extractor/backend
EnvironmentFile=/var/www/statement-extractor/backend/.env
ExecStart=/var/www/statement-extractor/backend/venv/bin/celery -A app.workers.celery_app worker \
  --loglevel=info \
  --concurrency=4 \
  --logfile=/var/log/statement-extractor/worker.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
